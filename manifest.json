{
  "manifest_version": 3,
  "name": "声境音效 SonicScape",
  "plugin_id": "sonic-scape",
  "version": "1.1.0",
  "description": "全屏调音台：31 套预设、可拖点 10 段 EQ、三层动态低音、双段亮度、齿音保护、压缩、卷积混响、耳机 crossfeed、R128 响度、AutoEQ 导入。",
  "moekoe": true,
  "minversion": "1.7.0",
  "homepage_url": "https://github.com/gaozil996/MoeKoeMusic-SonicScape",
  "author": {
    "name": "SHIYI",
    "url": "https://github.com/gaozil996/MoeKoeMusic-SonicScape"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "world": "MAIN",
      "js": [
        "sonic-scape.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  }
}
